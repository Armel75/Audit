# =============================================================================
# EXEMPLE — credentials du dépôt Git privé pour ArgoCD
# À adapter puis appliquer UNIQUEMENT si le repo est privé :
#   kubectl apply -n argocd -f argocd/repo-secret.yaml
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: audit-repo
  namespace: argocd
  labels:
    argocd.argoproj.io/secret-type: repository
stringData:
  type: git
  url: https://github.com/CHANGE_ME/audit.git
  username: CHANGE_ME
  # PAT (Personal Access Token) avec accès en lecture au repo
  password: CHANGE_ME
