# ═══════════════════════════════════════════════════════════════════════════
# SISAR Audit — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# ═══════════════════════════════════════════════════════════════════════════

# ── SQL Server ──────────────────────────────────────────────────────────
SA_PASSWORD="DevPassword123!"
SQL_PORT=1433

# ── API ─────────────────────────────────────────────────────────────────
API_PORT=3007
DATABASE_URL="sqlserver://sa:DevPassword123!@localhost:1433;database=AuditDB;encrypt=true;trustServerCertificate=true"
JWT_SECRET="change-this-to-a-strong-secret-in-production"
JWT_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN="30d"
WEB_ORIGIN="http://localhost:80"

# ── Gemini AI ───────────────────────────────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Bootstrap (Admin initial) ──────────────────────────────────────────
BOOTSTRAP_ENABLED=true
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_EMAIL=admin@audit.local
BOOTSTRAP_TENANT_ID=1
BOOTSTRAP_ADMIN_ROLE=SUPER_ADMIN
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=System
BOOTSTRAP_ADMIN_STATUS=ACTIVE
BOOTSTRAP_ADMIN_MATRICULE=ADMIN001

# ── GLPI Sync (optionnel) ──────────────────────────────────────────────
GLPI_DB_HOST=
GLPI_DB_PORT=3306
GLPI_DB_USER=root
GLPI_DB_PASSWORD=
GLPI_DB_NAME=glpi

# ── SMTP / Email (optionnel) ───────────────────────────────────────────
SMTP_HOST=192.168.0.247
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SISAR Audit <support@groupesorepco.com>"
WEB_APP_URL="http://localhost:5173/audit"
#WEB_APP_URL="http://192.168.0.13:84/audit"  # Prod : décommenter le moment venu
EMAIL_NOTIFICATIONS_ENABLED=true
# Copie (Directeur Général) sur les événements stratégiques uniquement
NOTIFICATION_CC_EMAIL=patrickdjemmo@groupesorepco.com

# ─── Alertes hebdomadaires (retards missions + recommandations) ─────────────────
# Email fixe du chef d'audit (reçoit une copie de chaque alerte)
ALERT_CHEF_AUDIT_EMAIL=jean.fonkou@audit.groupesorepco.com
# Jour du cron hebdo : 0=dimanche … 6=samedi  (1 = lundi par défaut)
ALERT_CRON_DAY=1
# Heure d'envoi du cron (0-23, 8h par défaut)
ALERT_CRON_HOUR=8
# Nombre de jours de grâce avant déclenchement de l'alerte
ALERT_GRACE_DAYS=5

# ── Storage ────────────────────────────────────────────────────────────
STORAGE_PATH=.storage

# ── Puppeteer / Chrome (optionnel, défaut Docker) ──────────────────────
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
