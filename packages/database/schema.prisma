generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ================= MULTI-TENANT =================
model Tenant {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(4000)
  code        String   @unique @db.VarChar(255)
  isActive    Boolean  @default(true)
  
  users       User[]
  plans       AuditPlan[]
  missions    AuditMission[]
  departments Department[]
  auditTypes  AuditType[]
  riskLevels  RiskLevel[]
  priorities  PriorityLevel[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================= IDENTITÉ & ACCÈS =================
model User {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  
  matricule     String    @unique @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  passwordHash  String    @db.VarChar(4000)
  firstName     String    @db.VarChar(4000)
  lastName      String    @db.VarChar(4000)
  phone         String?   @db.VarChar(4000)
  
  status        String    @default("PENDING") @db.VarChar(255)
  failedLogins  Int       @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  
  roleId        Int
  role          Role      @relation(fields: [roleId], references: [id])
  
  missionsLed   AuditMission[] @relation("MissionLeader")
  authoredFindings Finding[] @relation("FindingAuthor")
  validatedFindings Finding[] @relation("FindingValidator")
  recoComments  RecommendationComment[]
  findingComments FindingComment[]
  auditLogs     AuditLog[]
  
  refreshTokens RefreshToken[]
  resetTokens   PasswordResetToken[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @db.VarChar(4000)
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(255)
  description String?          @db.VarChar(4000)
  isLegacy    Boolean          @default(false)
  roles       RolePermission[]
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(255)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?  @db.VarChar(4000)
  userAgent String?  @db.VarChar(4000)
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(255)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ================= PARAMÉTRAGE =================
model Department { // Service
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  name        String   @db.VarChar(4000)
  code        String   @db.VarChar(255)
  
  recos       Recommendation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([tenantId, code])
}

model AuditType {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  name        String   @db.VarChar(4000)
  
  missions    AuditMission[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RiskLevel {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  name        String   @db.VarChar(4000)
  color       String?  @db.VarChar(4000)
  level       Int      // Pour le tri (1, 2, 3, 4)
  
  findings    Finding[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PriorityLevel {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  name        String   @db.VarChar(4000)
  level       Int
  
  recos       Recommendation[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================= MÉTIER AUDIT =================
model AuditPlan {
  id          Int            @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  year        Int
  status      String         @default("DRAFT") @db.VarChar(255)
  
  missions    AuditMission[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([tenantId, year])
}

model AuditMission {
  id          Int            @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  title       String         @db.VarChar(4000)
  description String         @db.VarChar(4000)
  startDate   DateTime?
  endDate     DateTime?
  status      String         @default("PLANNED") @db.VarChar(255)
  
  planId      Int
  plan        AuditPlan      @relation(fields: [planId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  auditTypeId Int?
  auditType   AuditType?     @relation(fields: [auditTypeId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  leaderId    Int
  leader      User           @relation("MissionLeader", fields: [leaderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  findings    Finding[]
  documents   Document[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Finding { // Constat
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(4000)
  description String         @db.VarChar(4000)
  
  riskLevelId Int?
  riskLevel   RiskLevel?     @relation(fields: [riskLevelId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  riskLevelLegacy String?    @db.VarChar(4000)
  
  process     String?        @db.VarChar(4000)
  cause       String?        @db.VarChar(4000)
  impact      String?        @db.VarChar(4000)
  
  status      String         @default("DRAFT") @db.VarChar(255)
  
  authorId    Int?
  author      User?          @relation("FindingAuthor", fields: [authorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  validatorId Int?
  validator   User?          @relation("FindingValidator", fields: [validatorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  missionId   Int
  mission     AuditMission   @relation(fields: [missionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  recos       Recommendation[]
  documents   Document[]
  comments    FindingComment[]
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FindingComment {
  id          Int      @id @default(autoincrement())
  content     String   @db.VarChar(4000)
  
  findingId   Int
  finding     Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Recommendation {
  id            Int            @id @default(autoincrement())
  title         String         @db.VarChar(4000)
  actionPlan    String         @db.VarChar(4000)
  targetDate    DateTime
  status        String         @default("OPEN") @db.VarChar(255)
  
  priorityId    Int?
  priority      PriorityLevel? @relation(fields: [priorityId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  departmentId  Int?
  department    Department?    @relation(fields: [departmentId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  assigneeName  String?        @db.VarChar(4000)
  
  findingId     Int
  finding       Finding        @relation(fields: [findingId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  documents     Document[]
  comments      RecommendationComment[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RecommendationComment {
  id               Int            @id @default(autoincrement())
  content          String         @db.VarChar(4000)
  
  recommendationId Int
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  
  authorId         Int
  author           User           @relation(fields: [authorId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ================= GESTION DOCUMENTAIRE =================
model Document {
  id               Int      @id @default(autoincrement())
  originalName     String   @db.VarChar(4000)
  mimeType         String   @db.VarChar(4000)
  sizeBytes        Int
  storagePath      String   @db.VarChar(4000)
  fileHash         String   @db.VarChar(4000)
  isGenerated      Boolean  @default(false)
  
  missionId        Int?
  mission          AuditMission?   @relation(fields: [missionId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  findingId        Int?
  finding          Finding?        @relation(fields: [findingId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  recommendationId Int?
  recommendation   Recommendation? @relation(fields: [recommendationId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  
  uploadedById     Int
  createdAt        DateTime @default(now())
  deletedAt        DateTime?
}

// ================= TRAÇABILITÉ =================
model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   @db.VarChar(4000)
  entityName  String?  @db.VarChar(255)
  entityId    String?  @db.VarChar(255)
  oldValues   String?  @db.VarChar(4000)
  newValues   String?  @db.VarChar(4000)
  
  userId      Int?
  user        User?    @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ipAddress   String?  @db.VarChar(4000)
  userAgent   String?  @db.VarChar(4000)
  
  createdAt   DateTime @default(now())

  @@index([entityName, entityId])
  @@index([createdAt])
}
