# =============================================================================
# Dockerfile Web — SISAR Audit Frontend (React + Vite + Nginx)
# Multi-stage build: deps → shared → build → nginx
# =============================================================================

# ── Stage 1: Install dependencies ──────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

# Copy root monorepo config
COPY package.json package-lock.json tsconfig.base.json ./
COPY .npmrc ./
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

RUN rm -rf node_modules package-lock.json && npm install --ignore-scripts

# ── Stage 2: Build shared package ──────────────────────────────────────────
FROM node:20-alpine AS build-shared

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared ./packages/shared

RUN cd packages/shared && npx tsup src/index.ts --format esm --dts --clean

# ── Stage 3: Build frontend ────────────────────────────────────────────────
FROM node:20-alpine AS build-web

WORKDIR /app

# Copy dependencies
COPY --from=deps /app/node_modules ./node_modules

# Copy shared package build
COPY --from=build-shared /app/packages/shared/dist ./packages/shared/dist
COPY --from=build-shared /app/packages/shared/package.json ./packages/shared/

# Copy source
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/web ./apps/web

# Injecter VITE_API_URL à la compilation
# (le fichier .env est exclu du contexte de build Docker via .dockerignore)
ARG VITE_API_URL=/api/audit
ENV VITE_API_URL=${VITE_API_URL}

# Build the frontend
RUN cd apps/web && npx vite build

# ── Stage 4: Production Nginx ──────────────────────────────────────────────
FROM nginx:alpine AS production

# Copy built assets
# L'app utilise une base Vite '/audit/' : on la sert sous /audit/
COPY --from=build-web /app/apps/web/dist /usr/share/nginx/html/audit

# Custom nginx config
RUN echo 'server { \
    listen 80; \
    root /usr/share/nginx/html; \
    index index.html; \
    # Health check endpoint \
    location /health { \
        access_log off; \
        return 200 "healthy\n"; \
        add_header Content-Type text/plain; \
    } \
    # API proxy — le frontend appelle /api/audit (VITE_API_URL), le backend sert /api/v1 \
    location /api/audit/ { \
        proxy_pass http://api:3007/api/v1/; \
        proxy_http_version 1.1; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
        proxy_set_header X-Forwarded-Proto $scheme; \
        proxy_read_timeout 300s; \
        client_max_body_size 100m; \
    } \
    # Fichiers uploadés servis par l'API \
    location /storage/ { \
        proxy_pass http://api:3007/storage/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; \
    } \
    # Redirige la racine vers /audit/ \
    location = / { \
        return 301 /audit/; \
    } \
    # App SISAR servie sous /audit/ \
    location /audit/ { \
        try_files $uri $uri/ /audit/index.html; \
        add_header Cache-Control "public, max-age=3600, immutable"; \
    } \
    # Fallback SPA — tous les autres chemins vers index.html de /audit \
    location / { \
        try_files $uri /audit/index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1:80/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
